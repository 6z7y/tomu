        <mxCell id="-UXSXbpd-N4uQV-vB-TY-44" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span&gt;&lt;span&gt;PLANAR (codec output):&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;  Left:  [L L L L L L]&lt;br&gt;&lt;/span&gt;&lt;span&gt;  Right: [R R R R R R]&lt;br&gt;&lt;/span&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;span&gt;INTERLEAVED (speakers need):&lt;br&gt;&lt;/span&gt;&lt;span&gt;  [L R L R L R L R L R]&lt;br&gt;&lt;/span&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;span&gt;WHY?&lt;br&gt;&lt;/span&gt;&lt;span&gt;Speakers expect alternating L/R samples.&lt;br&gt;&lt;/span&gt;&lt;span&gt;If you send planar → wrong sound (plays all L, then all R)&lt;br&gt;&lt;/span&gt;&lt;span&gt;If you send interleaved → correct stereo ✓&lt;/span&gt;" vertex="1">
          <mxGeometry height="226" width="349" x="183" y="2196" as="geometry" />
        </mxCell>
        <mxCell id="-UXSXbpd-N4uQV-vB-TY-46" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <Array as="points">
              <mxPoint x="647" y="2312" />
